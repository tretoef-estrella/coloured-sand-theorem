module

public import RequestProject.OddTheoremI.TheoremD
public import RequestProject.Payment.Block

/-!
# `CSI10_theorem_Dp_and_theorem_I.md`, Part I — Theorem I (Conjecture I of v3 §8, odd primes)

Namespace `ColouredSand.OddTwist`.

## Encodings

* `Sp p λ` is `S_p(λ) = Π_{t=1}^{k−1} (Fin ((p−1) d_k p^{k−t−1} 2^{|I|}) → ℤ_[p] ⧸ p^t) ×
  (Fin ((d_k−1) 2^{|I|}) → ℤ_[p] ⧸ p^k)`, the product over `t ∈ [1, k−1]` indexed by
  `t : Fin (k − 1)` (standing for `t + 1`), as in Theorem D_p. It is defined from `p` and the digits
  `d_t = digitL p λ t`, `k = kTop p λ`, `I = Iset p λ` of `λ + 1` only (all three are functions of
  `Nat.digits p (λ + 1)`): **its definition has no argument `i` or `e`**, which is the statement
  "`S_p(λ)` does not depend on `i` or `e`" of (I1).
* `Cmod p λ i e` is `C = (slots → ℤ_[p]) ⧸ range (p^k • Mp)` (column-vector convention).
* "`C` is generated by `2^{|I|}` elements" is `∃ g : Fin (2^{|I|}) → C, span (range g) = ⊤`.
* `M ⧸ c M` is `M ⧸ c • (⊤ : Submodule ℤ_[p] M)`; `ℤ_[p] ⧸ p^a` is `Zq p a`.
* **Invariant form** (`theorem_I_invariant`): `Y ⧸ p^{k+1} Y ≃ S_p(λ) × (Fin (2^{|I|}) → ℤ_[p] ⧸ p^{k+1})`.
  Since `p^k S_p(λ) = 0`, this says that in the decomposition of `Y` into cyclic modules exactly
  `2^{|I|}` summands have order `> p^k` (a summand of order `> p^k`, free or not, contributes one
  copy of `ℤ_[p] ⧸ p^{k+1}` to `Y ⧸ p^{k+1} Y`), and that the others form `S_p(λ)`; the statement
  itself only involves the module `Y`, so it is independent of the choice of decomposition.
-/

@[expose] public section

noncomputable section

namespace ColouredSand.OddTwist

open scoped Pointwise

variable (p : ℕ) [Fact p.Prime]

/-- **`S_p(λ)`** (Part I of `CSI10_theorem_Dp_and_theorem_I.md`): defined from `p` and the digits of
`λ + 1` only (no `i`, no `e`). -/
abbrev Sp (l : ℕ) : Type :=
  ((t : Fin (kTop p l - 1)) →
      Fin ((p - 1) * digitL p l (kTop p l) * p ^ (kTop p l - (t + 1) - 1) * 2 ^ (Iset p l).card) →
        Zq p (t + 1)) ×
    (Fin ((digitL p l (kTop p l) - 1) * 2 ^ (Iset p l).card) → Zq p (kTop p l))

/-- **`C`** `= (slots → ℤ_[p]) ⧸ range (p^k • Mp)` (Part I of `CSI10_theorem_Dp_and_theorem_I.md`). -/
abbrev Cmod (l i e : ℕ) : Type :=
  (slots p l i e → ℤ_[p]) ⧸ LinearMap.range ((p : ℤ_[p]) ^ kTop p l • (Mp p l i e).mulVecLin)

/-- **(I1)** (Part I of `CSI10_theorem_Dp_and_theorem_I.md`): for an odd prime `p`, `λ, i : ℕ` and
`e ≥ 1`, `Y_p(λ, i, e) ≅ S_p(λ) × C`; `S_p(λ)` (`Sp p λ`) is defined from `p` and the digits of
`λ + 1` only, so it does not depend on `i` or `e`. -/
theorem I1 (hp : Odd p) (l i e : ℕ) (he : 1 ≤ e) :
    Nonempty (Yp p l i e ≃ₗ[ℤ_[p]] (Sp p l × Cmod p l i e)) := by
  obtain ⟨e1⟩ := theorem_Dp p hp l i e he
  exact ⟨e1.trans (LinearEquiv.prodAssoc ℤ_[p] _ _ _).symm⟩

variable {p} in
lemma zq_smul_eq_zero {a k : ℕ} (h : a ≤ k) (z : Zq p a) : (p : ℤ_[p]) ^ k • z = 0 := by
  induction z using Submodule.Quotient.induction_on with
  | H y =>
    rw [← Submodule.Quotient.mk_smul, Submodule.Quotient.mk_eq_zero, Ideal.mem_span_singleton,
      smul_eq_mul]
    exact Dvd.dvd.mul_right (pow_dvd_pow _ h) _

/-- **(I2)** (Part I of `CSI10_theorem_Dp_and_theorem_I.md`): `p^k • S_p(λ) = 0`. -/
theorem I2 (l : ℕ) (x : Sp p l) : (p : ℤ_[p]) ^ kTop p l • x = 0 := by
  obtain ⟨f, g⟩ := x
  refine Prod.ext (funext fun t => funext fun j => ?_) (funext fun j => ?_)
  · exact zq_smul_eq_zero (by have := t.isLt; omega) _
  · exact zq_smul_eq_zero le_rfl _

/-- **(I3)**, first half (Part I of `CSI10_theorem_Dp_and_theorem_I.md`): `C` is generated by
`2^{|I|}` elements. -/
theorem I3_generators (l i e : ℕ) :
    ∃ g : Fin (2 ^ (Iset p l).card) → Cmod p l i e,
      Submodule.span ℤ_[p] (Set.range g) = ⊤ := by
  let E := (Fintype.equivFin (slots p l i e)).trans (finCongr (card_slots p l i e))
  refine ⟨fun j => Submodule.mkQ _ (Pi.single (E.symm j) 1), ?_⟩
  have hr : Set.range (fun j => Submodule.mkQ (LinearMap.range ((p : ℤ_[p]) ^ kTop p l •
      (Mp p l i e).mulVecLin)) (Pi.single (E.symm j) (1 : ℤ_[p]))) =
      Submodule.mkQ _ '' Set.range (Pi.basisFun ℤ_[p] (slots p l i e)) := by
    ext x
    simp only [Set.mem_range, Set.mem_image, Pi.basisFun_apply]
    constructor
    · rintro ⟨j, rfl⟩; exact ⟨_, ⟨E.symm j, rfl⟩, rfl⟩
    · rintro ⟨_, ⟨s, rfl⟩, rfl⟩; exact ⟨E s, by simp⟩
  rw [hr, Submodule.span_image, (Pi.basisFun ℤ_[p] _).span_eq, Submodule.map_top,
    Submodule.range_mkQ]

lemma range_le_smul_top (l i e : ℕ) :
    LinearMap.range ((p : ℤ_[p]) ^ kTop p l • (Mp p l i e).mulVecLin) ≤
      (p : ℤ_[p]) ^ (kTop p l + 1) • (⊤ : Submodule ℤ_[p] (slots p l i e → ℤ_[p])) := by
  rintro _ ⟨v, rfl⟩
  have hd := digitL_top_ne_zero p l
  rw [Submodule.mem_smul_pointwise_iff_exists]
  refine ⟨(p : ℤ_[p]) ^ (digitL p l (kTop p l) - 1) •
    (prodQ (Qdata p l i e (kTop p l)).Q 0 (digitL p l (kTop p l))).mulVec v, trivial, ?_⟩
  simp only [LinearMap.smul_apply, Matrix.mulVecLin_apply, Mp, Matrix.smul_mulVec, smul_smul,
    ← pow_add]
  congr 2
  omega

/-- **(I3)**, second half (Part I of `CSI10_theorem_Dp_and_theorem_I.md`):
`C ⧸ p^{k+1} C ≃ (Fin (2^{|I|}) → ℤ_[p] ⧸ p^{k+1})` (since `p^k Mp ∈ p^{k+1}`, by (M1) and
`d_k ≥ 1`). -/
theorem I3_quot (l i e : ℕ) :
    Nonempty ((Cmod p l i e ⧸ (p : ℤ_[p]) ^ (kTop p l + 1) • (⊤ : Submodule ℤ_[p] (Cmod p l i e)))
      ≃ₗ[ℤ_[p]] (Fin (2 ^ (Iset p l).card) → Zq p (kTop p l + 1))) := by
  set R := LinearMap.range ((p : ℤ_[p]) ^ kTop p l • (Mp p l i e).mulVecLin)
  set N := (p : ℤ_[p]) ^ (kTop p l + 1) • (⊤ : Submodule ℤ_[p] (slots p l i e → ℤ_[p]))
  have hmap : N.map R.mkQ = (p : ℤ_[p]) ^ (kTop p l + 1) • (⊤ : Submodule ℤ_[p] (Cmod p l i e)) := by
    rw [Submodule.map_pointwise_smul, Submodule.map_top, Submodule.range_mkQ]
  exact ⟨((Submodule.quotEquivOfEq _ _ hmap.symm).trans
    (Submodule.quotientQuotientEquivQuotient R N (range_le_smul_top p l i e))).trans
    ((quotFinEquiv _ _).trans (finCongrPi (card_slots p l i e)))⟩

/-! ### The invariant form -/

lemma smul_top_prod {X Y : Type*} [AddCommGroup X] [Module ℤ_[p] X] [AddCommGroup Y]
    [Module ℤ_[p] Y] (c : ℤ_[p]) :
    c • (⊤ : Submodule ℤ_[p] (X × Y)) = (c • (⊤ : Submodule ℤ_[p] X)).prod (c • ⊤) := by
  ext ⟨x, y⟩
  simp only [Submodule.mem_smul_pointwise_iff_exists, Submodule.mem_top, true_and,
    Submodule.mem_prod]
  constructor
  · rintro ⟨⟨a, b⟩, h⟩
    simp only [Prod.smul_mk, Prod.mk.injEq] at h
    exact ⟨⟨a, h.1⟩, ⟨b, h.2⟩⟩
  · rintro ⟨⟨a, ha⟩, ⟨b, hb⟩⟩
    exact ⟨(a, b), by simp [ha, hb]⟩

/-- **Theorem I, invariant form** (Part I of `CSI10_theorem_Dp_and_theorem_I.md`):
`Y_p(λ, i, e) ⧸ p^{k+1} Y_p(λ, i, e) ≃ S_p(λ) × (Fin (2^{|I|}) → ℤ_[p] ⧸ p^{k+1})`. With
`p^k S_p(λ) = 0` (I2), this says that exactly `2^{|I|}` cyclic summands of `Y_p(λ, i, e)` have order
`> p^k` and that the others form `S_p(λ)`. -/
theorem theorem_I_invariant (hp : Odd p) (l i e : ℕ) (he : 1 ≤ e) :
    Nonempty ((Yp p l i e ⧸ (p : ℤ_[p]) ^ (kTop p l + 1) • (⊤ : Submodule ℤ_[p] (Yp p l i e)))
      ≃ₗ[ℤ_[p]] (Sp p l × (Fin (2 ^ (Iset p l).card) → Zq p (kTop p l + 1)))) := by
  obtain ⟨e1⟩ := I1 p hp l i e he
  obtain ⟨e3⟩ := I3_quot p l i e
  have hbot : (p : ℤ_[p]) ^ (kTop p l + 1) • (⊤ : Submodule ℤ_[p] (Sp p l)) = ⊥ := by
    rw [eq_bot_iff]
    intro x hx
    obtain ⟨y, -, rfl⟩ := (Submodule.mem_smul_pointwise_iff_exists _ _ _).1 hx
    rw [Submodule.mem_bot, pow_succ', mul_smul, I2, smul_zero]
  exact ⟨((quotSmulCongr e1 _).trans ((Submodule.quotEquivOfEq _ _ (smul_top_prod p _)).trans
    (Payment.quotProdEquiv _ _))).trans (LinearEquiv.prodCongr
      ((Submodule.quotEquivOfEq _ _ hbot).trans (Submodule.quotEquivOfEqBot _ rfl)) e3)⟩

/-- **Theorem I** (Part I of `CSI10_theorem_Dp_and_theorem_I.md`; Conjecture I of the Coloured
Sand v3 §8, for every odd prime `p`), assembled: for an odd prime `p`, `λ, i : ℕ` and `e ≥ 1`,
(I1) `Y_p(λ, i, e) ≅ S_p(λ) × C`; (I2) `p^k S_p(λ) = 0`; (I3) `C` is generated by `2^{|I|}`
elements and `C ⧸ p^{k+1} C ≅ (ℤ_[p] ⧸ p^{k+1})^{2^{|I|}}`; and the invariant form
`Y ⧸ p^{k+1} Y ≅ S_p(λ) × (ℤ_[p] ⧸ p^{k+1})^{2^{|I|}}`. -/
theorem theorem_I (hp : Odd p) (l i e : ℕ) (he : 1 ≤ e) :
    Nonempty (Yp p l i e ≃ₗ[ℤ_[p]] (Sp p l × Cmod p l i e)) ∧
    (∀ x : Sp p l, (p : ℤ_[p]) ^ kTop p l • x = 0) ∧
    (∃ g : Fin (2 ^ (Iset p l).card) → Cmod p l i e, Submodule.span ℤ_[p] (Set.range g) = ⊤) ∧
    Nonempty ((Cmod p l i e ⧸ (p : ℤ_[p]) ^ (kTop p l + 1) • (⊤ : Submodule ℤ_[p] (Cmod p l i e)))
      ≃ₗ[ℤ_[p]] (Fin (2 ^ (Iset p l).card) → Zq p (kTop p l + 1))) ∧
    Nonempty ((Yp p l i e ⧸ (p : ℤ_[p]) ^ (kTop p l + 1) • (⊤ : Submodule ℤ_[p] (Yp p l i e)))
      ≃ₗ[ℤ_[p]] (Sp p l × (Fin (2 ^ (Iset p l).card) → Zq p (kTop p l + 1)))) :=
  ⟨I1 p hp l i e he, I2 p l, I3_generators p l i e, I3_quot p l i e,
    theorem_I_invariant p hp l i e he⟩

end ColouredSand.OddTwist
