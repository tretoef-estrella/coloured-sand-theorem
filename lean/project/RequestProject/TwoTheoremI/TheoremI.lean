module

public import RequestProject.TwoTheoremI.Even
public import RequestProject.TwoTheoremI.Digits

/-!
# `CSX2_theorem_I_prime_two.md`, Part I — Theorem I at `p = 2`

Namespace `ColouredSand.TwoI`.

## Encodings

* `Y_2(λ, i, e) = X^{(e)}(λ, i)` is `FamilyGroup.X ds α i` with `ds = Families.ds λ` and `α = e`
  (the group of the tower over `ℤ_[2]`); Parts (I1)–(I4) are stated for an arbitrary digit list
  `ds` (more general), and (I5) specializes to `ds = Families.ds λ`.
* `S_2(λ)` is `FamilyGroup.SC ds = Π_{a < k} (Fin (2^{k+|I|−1−a}) → ℤ_[2]) ⧸ 2^a`, i.e.
  `⊕_{a<k} (ℤ/2^a)^{2^{|I|+k−1−a}}`; its factor `a = 0` is zero, so this is
  `⊕_{h=1}^{k−1} (ℤ/2^h)^{2^{k−h−1+|I|}}`, exactly the `S_2(λ)` of the file.  It depends on `ds`
  only (no `α`, no `i`).
* `C = coker(2^k M)` is `CmodTwo ds α i` (`Even.lean`).
* `ℤ_[2] ⧸ 2^e` is `FamilyGroup.Q e = ℤ_[2] ⧸ Ideal.span {2^e}`; `M ⧸ c M` is
  `M ⧸ c • (⊤ : Submodule ℤ_[2] M)`; isomorphisms are `Nonempty (… ≃ₗ[ℤ_[2]] …)`.
* "`C` is generated by `N` elements" is `∃ g : Fin N → C, Submodule.span ℤ_[2] (Set.range g) = ⊤`.
* **Invariant form** (I4): `X ⧸ 2^{k+1} X ≃ S_2(λ) × (Fin N → ℤ_[2] ⧸ 2^{k+1})`.  Since
  `2^k S_2(λ) = 0` (I2), this says that exactly `N = 2^{|I|}` cyclic summands of `X` have order
  `> 2^k` (a free summand counting as one of them), and that the others form `S_2(λ)`.
-/

@[expose] public section

noncomputable section

namespace ColouredSand.TwoI

open Matrix Windows FamilyGroup
open scoped Pointwise

/-! ### General linear algebra -/

lemma twoI_smul_top_eq_span (c : ℤ_[2]) : c • (⊤ : Submodule ℤ_[2] ℤ_[2]) = Ideal.span {c} := by
  ext x
  simp only [Submodule.mem_smul_pointwise_iff_exists, Submodule.mem_top, true_and,
    Ideal.mem_span_singleton', smul_eq_mul]
  constructor
  · rintro ⟨y, rfl⟩; exact ⟨y, mul_comm _ _⟩
  · rintro ⟨y, rfl⟩; exact ⟨y, mul_comm _ _⟩

lemma twoI_smul_top_pi (n : ℕ) (c : ℤ_[2]) :
    c • (⊤ : Submodule ℤ_[2] (Fin n → ℤ_[2])) =
      Submodule.pi Set.univ (fun _ => c • (⊤ : Submodule ℤ_[2] ℤ_[2])) := by
  ext x
  simp only [Submodule.mem_smul_pointwise_iff_exists, Submodule.mem_top, true_and,
    Submodule.mem_pi, Set.mem_univ, forall_const]
  constructor
  · rintro ⟨y, rfl⟩ j; exact ⟨y j, rfl⟩
  · intro h
    choose y hy using h
    exact ⟨y, funext hy⟩

/-- `(Fin n → ℤ_[2]) ⧸ c • ⊤ ≃ (Fin n → ℤ_[2] ⧸ (c))`. -/
def twoI_finQuotEquiv (n : ℕ) (c : ℤ_[2]) :
    ((Fin n → ℤ_[2]) ⧸ c • (⊤ : Submodule ℤ_[2] (Fin n → ℤ_[2]))) ≃ₗ[ℤ_[2]]
      (Fin n → ℤ_[2] ⧸ Ideal.span {c}) :=
  ((Submodule.quotEquivOfEq _ _ (twoI_smul_top_pi n c)).trans (Submodule.quotientPi _)).trans
    (LinearEquiv.piCongrRight fun _ => Submodule.quotEquivOfEq _ _ (twoI_smul_top_eq_span c))

lemma twoI_map_smul_top {Y Z : Type*} [AddCommGroup Y] [Module ℤ_[2] Y] [AddCommGroup Z]
    [Module ℤ_[2] Z] (e : Y ≃ₗ[ℤ_[2]] Z) (c : ℤ_[2]) :
    (c • (⊤ : Submodule ℤ_[2] Y)).map (e : Y →ₗ[ℤ_[2]] Z) = c • (⊤ : Submodule ℤ_[2] Z) := by
  ext z
  simp only [Submodule.mem_map, Submodule.mem_smul_pointwise_iff_exists, Submodule.mem_top,
    true_and]
  constructor
  · rintro ⟨y, ⟨w, rfl⟩, rfl⟩
    exact ⟨e w, by simp⟩
  · rintro ⟨w, rfl⟩
    exact ⟨c • e.symm w, ⟨e.symm w, rfl⟩, by simp⟩

/-- `Y ⧸ c • ⊤` is transported along a linear equivalence. -/
def twoI_quotSmulCongr {Y Z : Type*} [AddCommGroup Y] [Module ℤ_[2] Y] [AddCommGroup Z]
    [Module ℤ_[2] Z] (e : Y ≃ₗ[ℤ_[2]] Z) (c : ℤ_[2]) :
    (Y ⧸ c • (⊤ : Submodule ℤ_[2] Y)) ≃ₗ[ℤ_[2]] (Z ⧸ c • (⊤ : Submodule ℤ_[2] Z)) :=
  Submodule.Quotient.equiv _ _ e (twoI_map_smul_top e c)

lemma twoI_smul_top_prod {Y Z : Type*} [AddCommGroup Y] [Module ℤ_[2] Y] [AddCommGroup Z]
    [Module ℤ_[2] Z] (c : ℤ_[2]) :
    c • (⊤ : Submodule ℤ_[2] (Y × Z)) = (c • (⊤ : Submodule ℤ_[2] Y)).prod (c • ⊤) := by
  ext ⟨x, y⟩
  simp only [Submodule.mem_smul_pointwise_iff_exists, Submodule.mem_top, true_and,
    Submodule.mem_prod]
  constructor
  · rintro ⟨⟨a, b⟩, h⟩
    simp only [Prod.smul_mk, Prod.mk.injEq] at h
    exact ⟨⟨a, h.1⟩, ⟨b, h.2⟩⟩
  · rintro ⟨⟨a, ha⟩, ⟨b, hb⟩⟩
    exact ⟨(a, b), by simp [ha, hb]⟩

/-- `(Y × Z) ⧸ (P × Q) ≃ (Y ⧸ P) × (Z ⧸ Q)`. -/
def twoI_quotProdEquiv {Y Z : Type*} [AddCommGroup Y] [Module ℤ_[2] Y] [AddCommGroup Z]
    [Module ℤ_[2] Z] (P : Submodule ℤ_[2] Y) (Q : Submodule ℤ_[2] Z) :
    ((Y × Z) ⧸ P.prod Q) ≃ₗ[ℤ_[2]] (Y ⧸ P) × (Z ⧸ Q) :=
  (Submodule.quotEquivOfEq _ _ (by
      rw [LinearMap.ker_prodMap, Submodule.ker_mkQ, Submodule.ker_mkQ])).trans
    (LinearMap.quotKerEquivOfSurjective (P.mkQ.prodMap Q.mkQ) (by
      rintro ⟨a, b⟩
      obtain ⟨a', rfl⟩ := Submodule.mkQ_surjective P a
      obtain ⟨b', rfl⟩ := Submodule.mkQ_surjective Q b
      exact ⟨(a', b'), rfl⟩))

/-! ### (I1) explicit form -/

/-- **(I1)** of `CSX2_theorem_I_prime_two.md`, case `k ≥ 1`, `i ≥ 1`: there are exponents
`E j ≥ k + 1` (`j < N`) with `X^{(α)}(ds, i) ≅ S_2 × Π_{j < N} ℤ_[2] ⧸ 2^{E j}`. -/
theorem twoI_I1_pos (ds : List Bool) (hk : 1 ≤ ds.length) (α i : ℕ) (hα : 1 ≤ α) (hi : 1 ≤ i) :
    ∃ E : ℕ → ℕ, (∀ j < 2 ^ Dance.mCount ds, ds.length + 1 ≤ E j) ∧
      Nonempty (X ds α i ≃ₗ[ℤ_[2]] SC ds × ((j : Fin (2 ^ Dance.mCount ds)) → Q (E j))) := by
  obtain ⟨E, hE, he⟩ := X1 ds hk α i hα hi
  refine ⟨E, fun j hj => ?_, he⟩
  have h1 := twoI_E2_pos ds hk α i hα hi j hj
  have h2 := hE j hj
  have : ((ds.length + 1 : ℕ) : ℤ) ≤ (E j : ℤ) := by push_cast; linarith
  exact_mod_cast this

/-- **(I1)** of `CSX2_theorem_I_prime_two.md`, case `k ≥ 1`, `i = 0`, `I ≠ ∅`: there are exponents
`E j ≥ k + 1` (`j < N − 1`) with `X^{(α)}(ds, 0) ≅ S_2 × (ℤ_[2] × Π_{j < N − 1} ℤ_[2] ⧸ 2^{E j})`. -/
theorem twoI_I1_zero (ds : List Bool) (hk : 1 ≤ ds.length) (α : ℕ) (hα : 1 ≤ α)
    (hne : Ids ds ≠ ∅) :
    ∃ E : ℕ → ℕ, (∀ j < 2 ^ Dance.mCount ds - 1, ds.length + 1 ≤ E j) ∧
      Nonempty (X ds α 0 ≃ₗ[ℤ_[2]]
        SC ds × (ℤ_[2] × ((j : Fin (2 ^ Dance.mCount ds - 1)) → Q (E j)))) := by
  obtain ⟨E, hE, he⟩ := X2 ds hk α hα hne
  refine ⟨E, fun j hj => ?_, he⟩
  have h1 := twoI_E2_zero ds hk α hα hne j hj
  have h2 := hE j hj
  have : ((ds.length + 1 : ℕ) : ℤ) ≤ (E j : ℤ) := by push_cast; linarith
  exact_mod_cast this

/-- **(I1)** of `CSX2_theorem_I_prime_two.md`, case `i = 0`, `I = ∅`:
`X^{(α)}(ds, 0) ≅ S_2 × ℤ_[2]` (this is `FamilyGroup.X3`). -/
theorem twoI_I1_empty (ds : List Bool) (α : ℕ) (hα : 1 ≤ α) (hI : Ids ds = ∅) :
    Nonempty (X ds α 0 ≃ₗ[ℤ_[2]] SC ds × ℤ_[2]) :=
  X3 ds α hα hI

lemma twoI_Ids_nil : Ids [] = ∅ := by simp [Ids]

lemma twoI_N_nil : 2 ^ Dance.mCount [] = 1 := rfl

/-- For `k = 0` the small part `S_2` is zero (auxiliary for (I1) of
`CSX2_theorem_I_prime_two.md`, case `k = 0`). -/
instance twoI_SC_nil_unique : Unique (SC []) where
  default := 0
  uniq := fun _ => funext fun a => Fin.elim0 a

/-- **(I1)** of `CSX2_theorem_I_prime_two.md`, case `k = 0` (`ds = []`), `i = 0`:
`X^{(α)}([], 0) ≅ ℤ_[2]`. -/
theorem twoI_I1_nil_zero (α : ℕ) (hα : 1 ≤ α) : Nonempty (X [] α 0 ≃ₗ[ℤ_[2]] ℤ_[2]) := by
  obtain ⟨e⟩ := X3 [] α hα twoI_Ids_nil
  exact ⟨e.trans (LinearEquiv.uniqueProd)⟩

/-- **(I1)** of `CSX2_theorem_I_prime_two.md`, case `k = 0` (`ds = []`), `i ≥ 1`:
`X^{(α)}([], i) ≅ ℤ_[2] ⧸ 2^{α + v_2(i)}`. -/
theorem twoI_I1_nil_pos (α i : ℕ) (hα : 1 ≤ α) (hi : 1 ≤ i) :
    Nonempty (X [] α i ≃ₗ[ℤ_[2]] Q (α + padicValNat 2 i)) := by
  set v := padicValNat 2 i
  set u := i / 2 ^ v
  have hiv : i = 2 ^ v * u := (Nat.mul_div_cancel' pow_padicValNat_dvd).symm
  have hu : ¬ 2 ∣ u := by
    intro h
    have h2 : 2 ^ (v + 1) ∣ i := by rw [hiv, pow_succ]; exact Nat.mul_dvd_mul_left _ h
    exact pow_succ_padicValNat_not_dvd (by omega) h2
  have huo : Odd (u : ℤ) := by
    rw [Int.odd_coe_nat]; exact Nat.odd_iff.2 (by omega)
  obtain ⟨e1⟩ := X_equiv_diag [] α i hα 1 1 (by simp) (by simp)
    (fun _ => (u : ℤ) * 2 ^ (α + v)) (by
      ext s s'
      have hs : s = s' := Fin.ext (by
        have h1 : (s : ℕ) < 1 := s.2; have h2 : (s' : ℕ) < 1 := s'.2; omega)
      subst hs
      rw [Matrix.one_mul, Matrix.mul_one, diagonal_apply_eq, twoI_finalMatrix_nil α i hα,
        hiv]
      push_cast; ring)
  have hspan : ∀ j : Fin (2 ^ Dance.mCount []),
      Ideal.span {(2 : ℤ_[2]) ^ ([] : List Bool).length * ((((u : ℤ) * 2 ^ (α + v) : ℤ)) : ℤ_[2])}
        = Ideal.span {(2 : ℤ_[2]) ^ (α + v)} := fun j => by
    rw [span_two_pow_unit huo]; simp
  let e2 : ((j : Fin (2 ^ Dance.mCount [])) → ℤ_[2] ⧸ Ideal.span {(2 : ℤ_[2]) ^
      ([] : List Bool).length * ((((u : ℤ) * 2 ^ (α + v) : ℤ)) : ℤ_[2])}) ≃ₗ[ℤ_[2]]
      (Fin (2 ^ Dance.mCount []) → Q (α + v)) :=
    LinearEquiv.piCongrRight fun j => Submodule.quotEquivOfEq _ _ (hspan j)
  let e3 : (Fin (2 ^ Dance.mCount []) → Q (α + v)) ≃ₗ[ℤ_[2]] Q (α + v) :=
    (LinearEquiv.funCongrLeft ℤ_[2] (Q (α + v)) (finCongr twoI_N_nil.symm)).trans
      (LinearEquiv.funUnique (Fin 1) ℤ_[2] (Q (α + v)))
  exact ⟨(e1.trans LinearEquiv.uniqueProd).trans (e2.trans e3)⟩

/-! ### (I2) -/

/-- **(I2)** of `CSX2_theorem_I_prime_two.md`, sharp form: `2^{k−1} • S_2 = 0` (every small summand
has order at most `2^{k−1}`). -/
theorem twoI_I2_pred (ds : List Bool) (x : SC ds) : (2 : ℤ_[2]) ^ (ds.length - 1) • x = 0 := by
  funext a
  rw [Pi.smul_apply, Pi.zero_apply]
  induction x a using Submodule.Quotient.induction_on with
  | H y =>
    rw [← Submodule.Quotient.mk_smul, Submodule.Quotient.mk_eq_zero,
      Submodule.mem_smul_pointwise_iff_exists]
    refine ⟨(2 : ℤ_[2]) ^ (ds.length - 1 - a) • y, trivial, ?_⟩
    rw [smul_smul, ← pow_add, show (a : ℕ) + (ds.length - 1 - a) = ds.length - 1 by
      have := a.2; omega]

/-- **(I2)** of `CSX2_theorem_I_prime_two.md`: `2^k • S_2 = 0` (the small summands have order at
most `2^k`; see `twoI_I2_pred` for `2^{k−1}`). -/
theorem twoI_I2 (ds : List Bool) (x : SC ds) : (2 : ℤ_[2]) ^ ds.length • x = 0 := by
  rcases Nat.eq_zero_or_pos ds.length with hk | hk
  · funext a; exact absurd a.2 (by omega)
  · have h2 : (2 : ℤ_[2]) ^ ds.length = 2 * 2 ^ (ds.length - 1) := by
      rw [← pow_succ']; congr 1; omega
    rw [h2, SemigroupAction.mul_smul, twoI_I2_pred, smul_zero]

/-! ### (I3) -/

/-- **(I3)** of `CSX2_theorem_I_prime_two.md`, first part: `X^{(α)}(ds, i) ≅ S_2 × C` with
`C = CmodTwo ds α i` (this is `FamilyGroup.X_equiv_coker`), for every `ds`. -/
theorem twoI_I3_equiv (ds : List Bool) (α i : ℕ) (hα : 1 ≤ α) :
    Nonempty (X ds α i ≃ₗ[ℤ_[2]] SC ds × CmodTwo ds α i) :=
  X_equiv_coker ds α i hα

/-- **(I3)** of `CSX2_theorem_I_prime_two.md`, second part: `C` is generated by `N = 2^{|I|}`
elements. -/
theorem twoI_I3_generators (ds : List Bool) (α i : ℕ) :
    ∃ g : Fin (2 ^ Dance.mCount ds) → CmodTwo ds α i,
      Submodule.span ℤ_[2] (Set.range g) = ⊤ := by
  refine ⟨fun j => Submodule.mkQ _ (Pi.basisFun ℤ_[2] _ j), ?_⟩
  rw [Set.range_comp' (Submodule.mkQ _) (Pi.basisFun ℤ_[2] _), Submodule.span_image,
    (Pi.basisFun ℤ_[2] _).span_eq, Submodule.map_top, Submodule.range_mkQ]

/-- The range of `2^k M` lies in `2^{k+1}(ℤ_[2])^N`, by (E1) (auxiliary for (I3) of
`CSX2_theorem_I_prime_two.md`). -/
lemma twoI_range_le (ds : List Bool) (α i : ℕ) (hα : 1 ≤ α) :
    LinearMap.range ((2 : ℤ_[2]) ^ ds.length •
        Matrix.toLin' ((finalMatrix ℤ ds α i).map (Int.castRingHom ℤ_[2]))) ≤
      (2 : ℤ_[2]) ^ (ds.length + 1) •
        (⊤ : Submodule ℤ_[2] (Fin (2 ^ Dance.mCount ds) → ℤ_[2])) := by
  rintro _ ⟨v, rfl⟩
  have hM := twoI_E1 ds α i hα
  choose M' hM' using hM
  have hmap : (finalMatrix ℤ ds α i).map (Int.castRingHom ℤ_[2]) =
      (2 : ℤ_[2]) • (Matrix.of M').map (Int.castRingHom ℤ_[2]) := by
    ext s s'; simp [hM']
  rw [Submodule.mem_smul_pointwise_iff_exists]
  refine ⟨((Matrix.of M').map (Int.castRingHom ℤ_[2])).mulVec v, trivial, ?_⟩
  rw [LinearMap.smul_apply, Matrix.toLin'_apply, hmap, Matrix.smul_mulVec, smul_smul, ← pow_succ]

/-- **(I3)** of `CSX2_theorem_I_prime_two.md`, third part (uses (E1)):
`C ⧸ 2^{k+1} C ≃ (Fin N → ℤ_[2] ⧸ 2^{k+1})`. -/
theorem twoI_I3_quot (ds : List Bool) (α i : ℕ) (hα : 1 ≤ α) :
    Nonempty ((CmodTwo ds α i ⧸
        (2 : ℤ_[2]) ^ (ds.length + 1) • (⊤ : Submodule ℤ_[2] (CmodTwo ds α i))) ≃ₗ[ℤ_[2]]
      (Fin (2 ^ Dance.mCount ds) → Q (ds.length + 1))) := by
  set R := LinearMap.range ((2 : ℤ_[2]) ^ ds.length •
    Matrix.toLin' ((finalMatrix ℤ ds α i).map (Int.castRingHom ℤ_[2])))
  set N := (2 : ℤ_[2]) ^ (ds.length + 1) •
    (⊤ : Submodule ℤ_[2] (Fin (2 ^ Dance.mCount ds) → ℤ_[2]))
  have hmap : N.map R.mkQ =
      (2 : ℤ_[2]) ^ (ds.length + 1) • (⊤ : Submodule ℤ_[2] (CmodTwo ds α i)) := by
    rw [Submodule.map_pointwise_smul, Submodule.map_top, Submodule.range_mkQ]
  exact ⟨((Submodule.quotEquivOfEq _ _ hmap.symm).trans
    (Submodule.quotientQuotientEquivQuotient R N (twoI_range_le ds α i hα))).trans
    (twoI_finQuotEquiv _ _)⟩

/-! ### (I4) the invariant form -/

/-- **(I4)** of `CSX2_theorem_I_prime_two.md` (invariant form), for every `ds`, `α ≥ 1`, `i`:
`X^{(α)}(ds, i) ⧸ 2^{k+1} X ≃ S_2 × (Fin N → ℤ_[2] ⧸ 2^{k+1})`.  With (I2) this says that exactly
`2^{|I|}` cyclic summands of `X` have order `> 2^k` (a free summand counting as one), and that the
others form `S_2(λ)`. -/
theorem twoI_I4 (ds : List Bool) (α i : ℕ) (hα : 1 ≤ α) :
    Nonempty ((X ds α i ⧸ (2 : ℤ_[2]) ^ (ds.length + 1) • (⊤ : Submodule ℤ_[2] (X ds α i)))
      ≃ₗ[ℤ_[2]] (SC ds × (Fin (2 ^ Dance.mCount ds) → Q (ds.length + 1)))) := by
  obtain ⟨e1⟩ := twoI_I3_equiv ds α i hα
  obtain ⟨e3⟩ := twoI_I3_quot ds α i hα
  have hbot : (2 : ℤ_[2]) ^ (ds.length + 1) • (⊤ : Submodule ℤ_[2] (SC ds)) = ⊥ := by
    rw [eq_bot_iff]
    intro x hx
    obtain ⟨y, -, rfl⟩ := (Submodule.mem_smul_pointwise_iff_exists _ _ _).1 hx
    rw [Submodule.mem_bot, pow_succ', SemigroupAction.mul_smul, twoI_I2, smul_zero]
  exact ⟨((twoI_quotSmulCongr e1 _).trans ((Submodule.quotEquivOfEq _ _ (twoI_smul_top_prod _)).trans
    (twoI_quotProdEquiv _ _))).trans (LinearEquiv.prodCongr
      ((Submodule.quotEquivOfEq _ _ hbot).trans (Submodule.quotEquivOfEqBot _ rfl)) e3)⟩

/-! ### (I5) assembled -/

/-- **Theorem I for `p = 2`, on an arbitrary digit list** (more general form of (I5) of
`CSX2_theorem_I_prime_two.md`): (I3) `X ≅ S_2 × C`; (I2) `2^k S_2 = 0`; `C` is generated by `N`
elements; `C ⧸ 2^{k+1} C ≅ (ℤ_[2] ⧸ 2^{k+1})^N`; and (I4)
`X ⧸ 2^{k+1} X ≅ S_2 × (ℤ_[2] ⧸ 2^{k+1})^N`. -/
theorem twoI_theorem_I_ds (ds : List Bool) (α i : ℕ) (hα : 1 ≤ α) :
    Nonempty (X ds α i ≃ₗ[ℤ_[2]] SC ds × CmodTwo ds α i) ∧
    (∀ x : SC ds, (2 : ℤ_[2]) ^ ds.length • x = 0) ∧
    (∃ g : Fin (2 ^ Dance.mCount ds) → CmodTwo ds α i, Submodule.span ℤ_[2] (Set.range g) = ⊤) ∧
    Nonempty ((CmodTwo ds α i ⧸
        (2 : ℤ_[2]) ^ (ds.length + 1) • (⊤ : Submodule ℤ_[2] (CmodTwo ds α i))) ≃ₗ[ℤ_[2]]
      (Fin (2 ^ Dance.mCount ds) → Q (ds.length + 1))) ∧
    Nonempty ((X ds α i ⧸ (2 : ℤ_[2]) ^ (ds.length + 1) • (⊤ : Submodule ℤ_[2] (X ds α i)))
      ≃ₗ[ℤ_[2]] (SC ds × (Fin (2 ^ Dance.mCount ds) → Q (ds.length + 1)))) :=
  ⟨twoI_I3_equiv ds α i hα, twoI_I2 ds, twoI_I3_generators ds α i, twoI_I3_quot ds α i hα,
    twoI_I4 ds α i hα⟩

/-- **(I5)** of `CSX2_theorem_I_prime_two.md` — **Theorem I for the prime 2**, assembled, mirroring
`ColouredSand.OddTwist.theorem_I`: for `λ, i : ℕ` and `α ≥ 1`, with `ds := Families.ds λ`
(`k = ds.length = ⌊log₂(λ+1)⌋`, `|I| = Dance.mCount ds`, see (I6)): (I3) `X ≅ S_2 × C`;
(I2) `2^k S_2 = 0`; `C` is generated by `2^{|I|}` elements; `C ⧸ 2^{k+1} C ≅ (ℤ_[2] ⧸ 2^{k+1})^{2^{|I|}}`;
and (I4) `X ⧸ 2^{k+1} X ≅ S_2 × (ℤ_[2] ⧸ 2^{k+1})^{2^{|I|}}`. -/
theorem twoI_theorem_I (l i α : ℕ) (hα : 1 ≤ α) :
    Nonempty (X (Families.ds l) α i ≃ₗ[ℤ_[2]] SC (Families.ds l) × CmodTwo (Families.ds l) α i) ∧
    (∀ x : SC (Families.ds l), (2 : ℤ_[2]) ^ (Families.ds l).length • x = 0) ∧
    (∃ g : Fin (2 ^ Dance.mCount (Families.ds l)) → CmodTwo (Families.ds l) α i,
      Submodule.span ℤ_[2] (Set.range g) = ⊤) ∧
    Nonempty ((CmodTwo (Families.ds l) α i ⧸ (2 : ℤ_[2]) ^ ((Families.ds l).length + 1) •
        (⊤ : Submodule ℤ_[2] (CmodTwo (Families.ds l) α i))) ≃ₗ[ℤ_[2]]
      (Fin (2 ^ Dance.mCount (Families.ds l)) → Q ((Families.ds l).length + 1))) ∧
