module

public import RequestProject.Strings.TheoremE

/-!
# Theorem E for every prime, including `p ∤ q` (CSX1, Part A)

This file corresponds to **Part A** of `CSX1_theorem_E_every_prime.md`: it removes the
hypothesis `1 ≤ v_p(q)` from Theorem E of `CS1` (`ColouredSand.Strings.theorem_E`), replacing it
by `q ≠ 0`.  In particular the case `p ∤ q` (`e = v_p(q) = 0`) is covered.

## Encoding (identical to `RequestProject/Strings/TheoremE.lean`, which is reused, not redefined)

* `B_m(ℤ_[p]) = B m ℤ_[p] = Finset (Fin m) → ℤ_[p]`, the free `ℤ_[p]`-module on the subsets of
  `{0,…,m-1}`; `H` (size) and `U` (up) are the operators `H m ℤ_[p]`, `U m ℤ_[p]` of
  `RequestProject/Strings/Basic.lean`.
* The operator `M = q (c + H) + U` is written literally as
  `(q : ℤ_[p]) • ((c : ℤ_[p]) • LinearMap.id + H m ℤ_[p]) + U m ℤ_[p]`.
* `e = v_p(q)` is `padicValInt p q` and `v_p(c + r)` is `padicValNat p (c + r)`;
  `A_k = expA p q c m k = ∑_{r=k}^{m-k} (e + v_p(c + r))`, and `C(m,k) − C(m,k−1)` is
  `strMult m k`.
* `coker M` is `B m ℤ_[p] ⧸ LinearMap.range M`, and "`≅`" is the existence (`Nonempty`) of a
  `ℤ_[p]`-linear equivalence.
* The free summand "`ℤ_[p]` if `c = 0`, else `0`" is `Fin (if c = 0 then 1 else 0) → ℤ_[p]`
  (so for `c = 0` the string `k = 0` contributes only this free summand).
* The direct sum over `0 ≤ k ≤ m/2`, `(c,k) ≠ (0,0)` is the finite product indexed by
  `Σ k : {k : Fin (m / 2 + 1) // (c, k) ≠ (0, 0)}, Fin (strMult m k)`.
* "`p ∤ q`" is `¬ (p : ℤ) ∣ q`.
-/

@[expose] public section

open Finset

namespace ColouredSand.Strings

/-- **CSX1, Part A, (A1).**  `span_prod_eq` with the hypothesis `q ≠ 0` instead of
`1 ≤ padicValInt p q`, same conclusion: for `2k ≤ m` and `(c,k) ≠ (0,0)`, the ideal of `ℤ_[p]`
generated by `∏_{i=0}^{m-2k} q (c + k + i)` is the ideal generated by `p ^ A_k`,
`A_k = expA p q c m k`.  (More general than `span_prod_eq`, since `1 ≤ v_p(q)` implies `q ≠ 0`.) -/
lemma strAll_span_prod_eq {p : ℕ} [Fact p.Prime] (q : ℤ) (hq : q ≠ 0) (c m k : ℕ)
    (hk : 2 * k ≤ m) (hck : (c, k) ≠ (0, 0)) :
    Ideal.span {∏ i : Fin (m - 2 * k + 1), (q : ℤ_[p]) * ((c : ℤ_[p]) + ((k + i : ℕ) : ℤ_[p]))} =
      Ideal.span {(p : ℤ_[p]) ^ expA p q c m k} := by
  rw [Ideal.span_singleton_eq_span_singleton]
  have hfac : ∀ i : Fin (m - 2 * k + 1),
      Associated ((q : ℤ_[p]) * ((c : ℤ_[p]) + ((k + i : ℕ) : ℤ_[p])))
        ((p : ℤ_[p]) ^ (padicValInt p q + padicValNat p (c + (k + i)))) := by
    intro i
    have hne : (c + (k + i) : ℕ) ≠ 0 := by
      intro h
      apply hck
      simp only [Prod.mk.injEq]
      omega
    have h := padicInt_associated_intCast (p := p) (z := q * ((c + (k + i) : ℕ) : ℤ))
      (mul_ne_zero hq (by exact_mod_cast hne))
    rw [padicValInt.mul hq (by exact_mod_cast hne), padicValInt.of_nat] at h
    convert h using 1
    push_cast
    ring
  have hsum : ∑ i : Fin (m - 2 * k + 1), (padicValInt p q + padicValNat p (c + (k + i))) =
      expA p q c m k := by
    rw [Fin.sum_univ_eq_sum_range (fun i => padicValInt p q + padicValNat p (c + (k + i))), expA,
      show Icc k (m - k) = Ico k (m - k + 1) by ext; simp only [mem_Icc, mem_Ico]; omega,
      sum_Ico_eq_sum_range, show m - k + 1 - k = m - 2 * k + 1 by omega]
  refine (Associated.prod _ _ _ (fun i _ => hfac i)).trans ?_
  rw [prod_pow_eq_pow_sum, hsum]
  exact Associated.refl _

/-- **CSX1, Part A, (A2): Theorem E for every prime.**  Let `p` be any prime, `q ∈ ℤ` with
`q ≠ 0` (no assumption on `e = v_p(q)`, which may be `0`), `c ∈ ℕ` and `m < p`.  With
`M := q (c + H) + U` on `B_m(ℤ_[p])`,
`coker M ≅ (ℤ_[p] if c = 0 else 0) ⊕ ⨁_{0 ≤ k ≤ m/2, (c,k) ≠ (0,0)}
(ℤ_[p] / (p^{A_k}))^{C(m,k) − C(m,k−1)}`, with `A_k = ∑_{r=k}^{m−k} (e + v_p(c + r))`.
The conclusion is exactly that of `theorem_E`; see the module docstring for the encoding.
The proof is that of `theorem_E`, with `strAll_span_prod_eq` in place of `span_prod_eq`. -/
theorem strAll_theorem_E (p : ℕ) [Fact p.Prime] (q : ℤ) (hq : q ≠ 0) (c m : ℕ) (hm : m < p) :
    Nonempty ((B m ℤ_[p] ⧸ LinearMap.range
        ((q : ℤ_[p]) • ((c : ℤ_[p]) • LinearMap.id + H m ℤ_[p]) + U m ℤ_[p])) ≃ₗ[ℤ_[p]]
      ((Fin (if c = 0 then 1 else 0) → ℤ_[p]) ×
        ((t : Σ k : {k : Fin (m / 2 + 1) // (c, (k : ℕ)) ≠ (0, 0)}, Fin (strMult m k)) →
          ℤ_[p] ⧸ Ideal.span {(p : ℤ_[p]) ^ expA p q c m t.1}))) := by
  classical
  have hR : ∀ n : ℕ, 1 ≤ n → n ≤ m → IsUnit (n : ℤ_[p]) :=
    fun n h1 h2 => padicInt_isUnit_natCast h1 (by omega)
  let β : Fin (m / 2 + 1) → ℕ := fun k => strMult m k
  let bas : (k : Fin (m / 2 + 1)) → Module.Basis (Fin (β k)) ℤ_[p] (Lam m ℤ_[p] k) := fun k =>
    Module.finBasisOfFinrankEq ℤ_[p] (Lam m ℤ_[p] k)
      (Lam_free_finrank hR (by have := k.2; omega)).2
  obtain ⟨E1⟩ := coker_opM_equiv β bas hR (q : ℤ_[p]) (c : ℤ_[p])
  let d : StrIdx β → ℤ_[p] := fun t =>
    ∏ i : Fin (m - 2 * (t.1 : ℕ) + 1), (q : ℤ_[p]) * ((c : ℤ_[p]) + ((t.1 + i : ℕ) : ℤ_[p]))
  let X : StrIdx β → Type := fun t => ℤ_[p] ⧸ Ideal.span {d t}
  let Z : StrIdx β → Prop := fun t => (c, ((t.1 : Fin (m / 2 + 1)) : ℕ)) = (0, 0)
  let eS := Equiv.sumCompl Z
  let EA : ((t : StrIdx β) → X t) ≃ₗ[ℤ_[p]] ((s : {t // Z t} ⊕ {t // ¬ Z t}) → X (eS s)) :=
    (LinearEquiv.piCongrLeft ℤ_[p] X eS).symm
  let EB := LinearEquiv.sumPiEquivProdPi ℤ_[p] {t // Z t} {t // ¬ Z t} (fun s => X (eS s))
  have hd0 : ∀ a : {t // Z t}, Ideal.span {d a.1} = ⊥ := by
    intro a
    rw [Ideal.span_singleton_eq_bot]
    have ha := a.2
    simp only [Z, Prod.mk.injEq] at ha
    refine prod_eq_zero (i := ⟨0, by omega⟩) (mem_univ _) ?_
    simp [ha.1, ha.2]
  let EF1 : ((a : {t // Z t}) → X a.1) ≃ₗ[ℤ_[p]] ({t // Z t} → ℤ_[p]) :=
    LinearEquiv.piCongrRight (fun a => Submodule.quotEquivOfEqBot _ (hd0 a))
  have hcard : Fintype.card (Fin (if c = 0 then 1 else 0)) = Fintype.card {t // Z t} := by
    rw [Fintype.card_fin]
    split_ifs with hc
    · symm
      rw [Fintype.card_eq_one_iff]
      have h1 : 0 < β ⟨0, by omega⟩ := by simp [β, strMult]
      refine ⟨⟨⟨⟨0, by omega⟩, ⟨0, h1⟩⟩, by simp [Z, hc]⟩, ?_⟩
      rintro ⟨⟨k, j⟩, hk⟩
      simp only [Z, Prod.mk.injEq, hc, true_and] at hk
      obtain rfl : k = ⟨0, Nat.succ_pos _⟩ := Fin.ext hk
      have hj : (j : ℕ) = 0 := by
        have := j.2
        simp only [β, strMult, Nat.choose_zero_right, if_true, Nat.sub_zero] at this
        omega
      congr
      exact Fin.ext hj
    · symm
      rw [Fintype.card_eq_zero_iff]
      refine ⟨fun a => ?_⟩
      have := a.2
      simp only [Z, Prod.mk.injEq] at this
      exact hc this.1
  let EF2 : ({t // Z t} → ℤ_[p]) ≃ₗ[ℤ_[p]] (Fin (if c = 0 then 1 else 0) → ℤ_[p]) :=
    LinearEquiv.funCongrLeft ℤ_[p] ℤ_[p] (Fintype.equivOfCardEq hcard)
  have hdA : ∀ b : {t // ¬ Z t}, Ideal.span {d b.1} =
      Ideal.span {(p : ℤ_[p]) ^ expA p q c m b.1.1} := fun b =>
    strAll_span_prod_eq q hq c m b.1.1 (by have := b.1.1.2; omega) b.2
  let ET1 : ((b : {t // ¬ Z t}) → X b.1) ≃ₗ[ℤ_[p]]
      ((b : {t // ¬ Z t}) → ℤ_[p] ⧸ Ideal.span {(p : ℤ_[p]) ^ expA p q c m b.1.1}) :=
    LinearEquiv.piCongrRight (fun b => Submodule.quotEquivOfEq _ _ (hdA b))
  let eT := strIdxEquiv c m
  let ET2 := LinearEquiv.piCongrLeft ℤ_[p]
    (fun t : (Σ k : {k : Fin (m / 2 + 1) // (c, (k : ℕ)) ≠ (0, 0)}, Fin (strMult m k)) =>
      ℤ_[p] ⧸ Ideal.span {(p : ℤ_[p]) ^ expA p q c m t.1}) eT
  exact ⟨E1.trans (EA.trans (EB.trans ((EF1.trans EF2).prodCongr (ET1.trans ET2))))⟩

/-- **CSX1, Part A, (A3), the exponent.**  If `p ∤ q` then `e = v_p(q) = 0`, so
`A_k = ∑_{r=k}^{m-k} v_p(c + r)` for every `k`.  (Valid for every `p`.) -/
lemma strAll_expA_coprime (p : ℕ) (q : ℤ) (hq : ¬ (p : ℤ) ∣ q) (c m k : ℕ) :
    expA p q c m k = ∑ r ∈ Icc k (m - k), padicValNat p (c + r) := by
  simp [expA, padicValInt.eq_zero_of_not_dvd hq]

/-- **CSX1, Part A, (A3): the case `p ∤ q` written out.**  For a prime `p`, `q ∈ ℤ` with
`¬ (p : ℤ) ∣ q`, `c ∈ ℕ` and `m < p`: the isomorphism of Theorem E holds (exactly the conclusion
of `theorem_E`), and `A_k = expA p q c m k = ∑_{r=k}^{m-k} v_p(c + r)` for every `k`. -/
theorem strAll_theorem_E_coprime (p : ℕ) [Fact p.Prime] (q : ℤ) (hq : ¬ (p : ℤ) ∣ q) (c m : ℕ)
    (hm : m < p) :
    Nonempty ((B m ℤ_[p] ⧸ LinearMap.range
        ((q : ℤ_[p]) • ((c : ℤ_[p]) • LinearMap.id + H m ℤ_[p]) + U m ℤ_[p])) ≃ₗ[ℤ_[p]]
      ((Fin (if c = 0 then 1 else 0) → ℤ_[p]) ×
        ((t : Σ k : {k : Fin (m / 2 + 1) // (c, (k : ℕ)) ≠ (0, 0)}, Fin (strMult m k)) →
          ℤ_[p] ⧸ Ideal.span {(p : ℤ_[p]) ^ expA p q c m t.1}))) ∧
      ∀ k, expA p q c m k = ∑ r ∈ Icc k (m - k), padicValNat p (c + r) := by
  have hq0 : q ≠ 0 := by rintro rfl; exact hq (dvd_zero _)
  exact ⟨strAll_theorem_E p q hq0 c m hm, strAll_expA_coprime p q hq c m⟩

/-- **CSX1, Part A, (A3), substituted form** (an addition, not in the file).  For `p ∤ q` the
isomorphism of Theorem E with the exponent written explicitly as
`∑_{r=k}^{m-k} v_p(c + r)` (no `e` term). -/
theorem strAll_theorem_E_coprime_explicit (p : ℕ) [Fact p.Prime] (q : ℤ) (hq : ¬ (p : ℤ) ∣ q)
    (c m : ℕ) (hm : m < p) :
    Nonempty ((B m ℤ_[p] ⧸ LinearMap.range
        ((q : ℤ_[p]) • ((c : ℤ_[p]) • LinearMap.id + H m ℤ_[p]) + U m ℤ_[p])) ≃ₗ[ℤ_[p]]
      ((Fin (if c = 0 then 1 else 0) → ℤ_[p]) ×
        ((t : Σ k : {k : Fin (m / 2 + 1) // (c, (k : ℕ)) ≠ (0, 0)}, Fin (strMult m k)) →
          ℤ_[p] ⧸ Ideal.span
            {(p : ℤ_[p]) ^ ∑ r ∈ Icc (t.1 : ℕ) (m - t.1), padicValNat p (c + r)}))) := by
  obtain ⟨h, hA⟩ := strAll_theorem_E_coprime p q hq c m hm
  have hfun : expA p q c m = fun k => ∑ r ∈ Icc k (m - k), padicValNat p (c + r) := funext hA
  rw [hfun] at h
  exact h

/-- **CSX1, Part A, (A4): agreement.**  For `1 ≤ padicValInt p q`, (A2) gives back `theorem_E`:
this is the statement of `theorem_E`, obtained from `strAll_theorem_E` since `1 ≤ v_p(q)` forces
`q ≠ 0`. -/
theorem strAll_theorem_E_eq (p : ℕ) [Fact p.Prime] (q : ℤ) (hq : 1 ≤ padicValInt p q) (c m : ℕ)
    (hm : m < p) :
    Nonempty ((B m ℤ_[p] ⧸ LinearMap.range
        ((q : ℤ_[p]) • ((c : ℤ_[p]) • LinearMap.id + H m ℤ_[p]) + U m ℤ_[p])) ≃ₗ[ℤ_[p]]
      ((Fin (if c = 0 then 1 else 0) → ℤ_[p]) ×
        ((t : Σ k : {k : Fin (m / 2 + 1) // (c, (k : ℕ)) ≠ (0, 0)}, Fin (strMult m k)) →
          ℤ_[p] ⧸ Ideal.span {(p : ℤ_[p]) ^ expA p q c m t.1}))) :=
  strAll_theorem_E p q (by rintro rfl; simp at hq) c m hm

end ColouredSand.Strings
