@ColouredSand.OddTwist.oddF_lemma_F : ∀ {p : ℕ} {I : Finset ℕ} {k ℓ : ℕ} {dg : ℕ → ℕ} {e : ℤ} {c : ℕ} {V' : ℕ → ℤ}
  [Fact (Nat.Prime p)],
  (∀ t ∈ I, t < k) →
    (∀ t ∈ I, 1 ≤ dg t ∧ dg t ≤ p - 1) →
      ℓ < p ^ k →
        1 ≤ e →
          ∀ (hne : I.Nonempty),
            c = I.max' hne →
              ColouredSand.OddTwist.IsPotentialP p c (I.erase c) dg (ℓ % p ^ c) e V' →
                ∀ {f : ℕ},
                  IsLeast {q | q < 2 ^ (I.erase c).card ∧ ColouredSand.OddTwist.X1P p k I dg ℓ e c q ≤ 0} f →
