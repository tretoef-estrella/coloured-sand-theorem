@ColouredSand.OddTwist.oddF_theorem_F0 : ∀ {p : ℕ} [hp : Fact (Nat.Prime p)] {dg : ℕ → ℕ} {I : Finset ℕ} {k ℓ : ℕ}
  {e : ℤ},
  (∀ t ∈ I, t < k) →
    (∀ t ∈ I, 1 ≤ dg t ∧ dg t ≤ p - 1) →
      ℓ < p ^ k →
        1 ≤ e →
          ∀ (hne : I.Nonempty) {c : ℕ},
            c = I.max' hne →
              (∀ q < 2 ^ (I.erase c).card,
                  ColouredSand.OddTwist.xHseqP p k I dg ℓ e q =
                    ColouredSand.OddTwist.xHseqP p c (I.erase c) dg (ℓ % p ^ c) e q +
                      ColouredSand.OddTwist.dWalkP p k I dg ℓ e c q) ∧
                ((∀ (q : ℕ),
                      q + 1 < 2 ^ (I.erase c).card →
                        ColouredSand.OddTwist.dWalkP p k I dg ℓ e c (q + 1) ≤
                          ColouredSand.OddTwist.dWalkP p k I dg ℓ e c q) ∧
                    ∀ (q : ℕ),
                      0 < q →
                        q < 2 ^ (I.erase c).card →
                          ColouredSand.OddTwist.dWalkP p k I dg ℓ e c (q - 1) ≠
                              ColouredSand.OddTwist.dWalkP p k I dg ℓ e c q →
                            ∃ b' < 2 ^ (I.erase c).card,
                              ColouredSand.OddTwist.JHseqP p c (I.erase c) dg (ℓ % p ^ c) b' = 1 ∧
                                (∀ q' < b', ColouredSand.OddTwist.JHseqP p c (I.erase c) dg (ℓ % p ^ c) q' = 0) ∧
                                  (q = b' ∨ q = 2 ^ (I.erase c).card - b')) ∧
                  ((∀ q < 2 ^ (I.erase c).card,
                        AntitonicFit.fit (2 ^ (I.erase c).card)
                            (AntitonicFit.toR
                              (ColouredSand.OddTwist.xHseqP p c (I.erase c) dg (ℓ % p ^ c) e +
                                ColouredSand.OddTwist.dWalkP p k I dg ℓ e c))
                            q =
                          AntitonicFit.fit (2 ^ (I.erase c).card)
                              (AntitonicFit.toR (ColouredSand.OddTwist.xHseqP p c (I.erase c) dg (ℓ % p ^ c) e)) q +
                            ↑(ColouredSand.OddTwist.dWalkP p k I dg ℓ e c q)) ∧
                      ∀ q < 2 ^ (I.erase c).card,
                        AntitonicFit.ifit (2 ^ (I.erase c).card)
                            (ColouredSand.OddTwist.xHseqP p c (I.erase c) dg (ℓ % p ^ c) e +
                              ColouredSand.OddTwist.dWalkP p k I dg ℓ e c)
                            q =
                          AntitonicFit.ifit (2 ^ (I.erase c).card)
                              (ColouredSand.OddTwist.xHseqP p c (I.erase c) dg (ℓ % p ^ c) e) q +
                            ColouredSand.OddTwist.dWalkP p k I dg ℓ e c q) ∧
                    (∀ q < 2 ^ I.card,
                        AntitonicFit.fit (2 ^ I.card) (AntitonicFit.toR (ColouredSand.OddTwist.xHseqP p k I dg ℓ e)) q =
                          AntitonicFit.concat (2 ^ (I.erase c).card)
                            (fun i =>
                              max
                                ((AntitonicFit.fit (2 ^ (I.erase c).card)
                                      (AntitonicFit.toR
                                        (ColouredSand.OddTwist.xHseqP p c (I.erase c) dg (ℓ % p ^ c) e)) +
                                    AntitonicFit.toR (ColouredSand.OddTwist.dWalkP p k I dg ℓ e c))
                                  i)
                                0)
                            (fun i =>
                              min
                                (AntitonicFit.mirror (2 ^ (I.erase c).card)
                                  (AntitonicFit.fit (2 ^ (I.erase c).card)
                                      (AntitonicFit.toR
                                        (ColouredSand.OddTwist.xHseqP p c (I.erase c) dg (ℓ % p ^ c) e)) +
                                    AntitonicFit.toR (ColouredSand.OddTwist.dWalkP p k I dg ℓ e c))
                                  i)
                                0)
                            q) ∧
                      ∀ q < 2 ^ I.card,
                        AntitonicFit.ifit (2 ^ I.card) (ColouredSand.OddTwist.xHseqP p k I dg ℓ e) q =
                          AntitonicFit.concat (2 ^ (I.erase c).card)
                            (fun i =>
                              max
                                ((AntitonicFit.ifit (2 ^ (I.erase c).card)
                                      (ColouredSand.OddTwist.xHseqP p c (I.erase c) dg (ℓ % p ^ c) e) +
                                    ColouredSand.OddTwist.dWalkP p k I dg ℓ e c)
                                  i)
                                0)
                            (fun i =>
                              min
                                (AntitonicFit.mirror (2 ^ (I.erase c).card)
                                  (AntitonicFit.ifit (2 ^ (I.erase c).card)
                                      (ColouredSand.OddTwist.xHseqP p c (I.erase c) dg (ℓ % p ^ c) e) +
                                    ColouredSand.OddTwist.dWalkP p k I dg ℓ e c)
                                  i)
                                0)
                            q
@ColouredSand.OddTwist.oddF_lemma_P : ∀ {p : ℕ} {I : Finset ℕ} {k ℓ : ℕ} {dg : ℕ → ℕ} {e : ℤ} {c : ℕ} {V' : ℕ → ℤ}
  [Fact (Nat.Prime p)],
  (∀ t ∈ I, t < k) →
    (∀ t ∈ I, 1 ≤ dg t ∧ dg t ≤ p - 1) →
      ℓ < p ^ k →
        1 ≤ e →
          ∀ (hne : I.Nonempty),
            c = I.max' hne →
              ColouredSand.OddTwist.IsPotentialP p c (I.erase c) dg (ℓ % p ^ c) e V' →
                ((∀ (q q' : ℕ),
                      Potential.IsArrow I q q' →
                        q < 2 ^ (I.erase c).card →
                          q' < 2 ^ (I.erase c).card →
                            ColouredSand.OddTwist.vPrimeP p k I dg ℓ e c V' q -
                                  ColouredSand.OddTwist.vPrimeP p k I dg ℓ e c V' q' +
                                ↑(k - c) ≤
                              ColouredSand.OddTwist.cHatSeqP p k I dg ℓ e q q') ∧
                    (∀ (q q' : ℕ),
                        Potential.IsArrow I q q' →
                          2 ^ (I.erase c).card ≤ q →
                            2 ^ (I.erase c).card ≤ q' →
                              ColouredSand.OddTwist.vPrimeP p k I dg ℓ e c V' q -
                                    ColouredSand.OddTwist.vPrimeP p k I dg ℓ e c V' q' +
                                  ↑(k - c) ≤
                                ColouredSand.OddTwist.cHatSeqP p k I dg ℓ e q q') ∧
                      (∀ (q q' : ℕ),
                          Potential.IsArrow I q q' →
                            2 ^ (I.erase c).card ≤ q →
                              q' < 2 ^ (I.erase c).card →
                                ColouredSand.OddTwist.vPrimeP p k I dg ℓ e c V' q -
                                    ColouredSand.OddTwist.vPrimeP p k I dg ℓ e c V' q' ≤
                                  ColouredSand.OddTwist.cHatSeqP p k I dg ℓ e q q') ∧
                        ∀ (q q' : ℕ),
                          q < 2 ^ (I.erase c).card → 2 ^ (I.erase c).card ≤ q' → ¬Potential.IsArrow I q q') ∧
                  ((∀ q < 2 ^ (I.erase c).card,
                        ColouredSand.OddTwist.vPrimeP p k I dg ℓ e c V' q -
                            ColouredSand.OddTwist.vPrimeP p k I dg ℓ e c V' (2 ^ I.card - 1 - q) =
                          ColouredSand.OddTwist.X1P p k I dg ℓ e c q) ∧
                      ∀ q < 2 ^ (I.erase c).card,
                        ColouredSand.OddTwist.vPrimeP p k I dg ℓ e c V' (2 ^ (I.erase c).card + q) -
                            ColouredSand.OddTwist.vPrimeP p k I dg ℓ e c V' (2 ^ (I.erase c).card - 1 - q) =
                          -ColouredSand.OddTwist.X1P p k I dg ℓ e c (2 ^ (I.erase c).card - 1 - q)) ∧
                    ((∀ (q q' : ℕ),
                          q ≤ q' →
                            q' < 2 ^ (I.erase c).card →
                              ColouredSand.OddTwist.vPrimeP p k I dg ℓ e c V' q' ≤
                                ColouredSand.OddTwist.vPrimeP p k I dg ℓ e c V' q) ∧
                        ∀ (q q' : ℕ),
                          2 ^ (I.erase c).card ≤ q →
                            q ≤ q' →
                              q' < 2 ^ I.card →
                                ColouredSand.OddTwist.vPrimeP p k I dg ℓ e c V' q' ≤
                                  ColouredSand.OddTwist.vPrimeP p k I dg ℓ e c V' q) ∧
                      ColouredSand.OddTwist.vPrimeP p k I dg ℓ e c V' (2 ^ (I.erase c).card) -
                            ColouredSand.OddTwist.vPrimeP p k I dg ℓ e c V' (2 ^ (I.erase c).card - 1) =
                          -ColouredSand.OddTwist.X1P p k I dg ℓ e c (2 ^ (I.erase c).card - 1) ∧
                        -ColouredSand.OddTwist.X1P p k I dg ℓ e c (2 ^ (I.erase c).card - 1) ≤
                            ↑(k - c) - e * (↑(dg c) * ↑p ^ c - ↑(ColouredSand.OddTwist.oW p dg (I.erase c))) ∧
                          ↑(k - c) - e * (↑(dg c) * ↑p ^ c - ↑(ColouredSand.OddTwist.oW p dg (I.erase c))) ≤
                            ↑(k - c) - e
@ColouredSand.OddTwist.oddF_lemma_X : ∀ {p : ℕ} {I : Finset ℕ} {k ℓ : ℕ} {dg : ℕ → ℕ} {e : ℤ} {c : ℕ} {V' : ℕ → ℤ}
  [Fact (Nat.Prime p)],
  (∀ t ∈ I, 1 ≤ dg t ∧ dg t ≤ p - 1) →
    ColouredSand.OddTwist.IsPotentialP p c (I.erase c) dg (ℓ % p ^ c) e V' →
      ∀ (q q' : ℕ),
        q ≤ q' →
          q' < 2 ^ (I.erase c).card →
