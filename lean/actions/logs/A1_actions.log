def ColouredSand.Exponent.expE : ℕ → ℕ → ℕ → ℕ :=
fun p q d => if 1 ≤ padicValNat p q then (Icc 1 d).sup fun s => padicValNat p q * s + padicValNat p s else Nat.log p d
def ColouredSand.Exponent.carryPairs : ℕ → Finset (ℕ × ℕ) :=
fun d => {x ∈ Icc 1 d ×ˢ Icc 1 d | x.1 ≤ x.2}
@mem_carryPairs : ∀ {d : ℕ} {x : ℕ × ℕ}, x ∈ carryPairs d ↔ 1 ≤ x.1 ∧ x.1 ≤ x.2 ∧ x.2 ≤ d
