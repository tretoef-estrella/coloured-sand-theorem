@[reducible] def ColouredSand.TheoremB.cokerL : ℕ → ℕ → Type :=
fun d q => ((Fin d → Fin q) → ℤ) ⧸ (laplacian d q).range
@[reducible] def ColouredSand.TheoremB.sandpile : (d q : ℕ) → Submodule ℤ (cokerL d q) :=
fun d q => Submodule.torsion ℤ (cokerL d q)
def ColouredSand.TheoremB.nCount : ℕ → ℕ → ℕ → ℕ :=
fun d q v =>
  ∑ j ∈ range (d + 1),
    ∑ k ∈ range (d + 1), if j + 2 * k = d + 1 - v ∧ (j, k) ≠ (0, 0) then d.choose j * (q - 2) ^ j * ballot k v else 0
def ColouredSand.TheoremB.ballot : ℕ → ℕ → ℕ :=
fun k v => (v + 2 * k - 1).choose k - if k = 0 then 0 else (v + 2 * k - 1).choose (k - 1)
laplacian_apply : ∀ (d q : ℕ) (f : (Fin d → Fin q) → ℤ) (x : Fin d → Fin q),
  (laplacian d q) f x = ↑((hammingGraph d q).degree x) * f x - ∑ y ∈ (hammingGraph d q).neighborFinset x, f y
