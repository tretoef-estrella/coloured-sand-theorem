@H_single : ∀ {m : ℕ} {R : Type u_1} [inst : CommRing R] (S : Finset (Fin m)),
  (H m R) (Pi.single S 1) = ↑(#S) • Pi.single S 1
@U_single : ∀ {m : ℕ} {R : Type u_1} [inst : CommRing R] (S : Finset (Fin m)),
  (U m R) (Pi.single S 1) = ∑ x ∈ Sᶜ, Pi.single (insert x S) 1
@D_single : ∀ {m : ℕ} {R : Type u_1} [inst : CommRing R] (S : Finset (Fin m)),
  (D m R) (Pi.single S 1) = ∑ x ∈ S, Pi.single (S.erase x) 1
