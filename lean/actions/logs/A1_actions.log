def ColouredSand.Splitting.hammingGraph : (d q : ℕ) → SimpleGraph (Fin d → Fin q) :=
fun d q => { Adj := fun x y => hammingDist x y = 1, symm := ⋯, loopless := ⋯ }
def ColouredSand.Splitting.laplacian : (d q : ℕ) → ((Fin d → Fin q) → ℤ) →ₗ[ℤ] (Fin d → Fin q) → ℤ :=
fun d q => (SimpleGraph.lapMatrix ℤ (hammingGraph d q)).mulVecLin
laplacian_apply : ∀ (d q : ℕ) (f : (Fin d → Fin q) → ℤ) (x : Fin d → Fin q),
  (laplacian d q) f x = ↑((hammingGraph d q).degree x) * f x - ∑ y ∈ (hammingGraph d q).neighborFinset x, f y
Mq_apply : ∀ (q m c : ℕ) (f : B m ℤ) (S : Finset (Fin m)),
  (Mq q m c) f S = ↑q * (↑c + ↑(#S)) * f S + ∑ x ∈ S, f (S.erase x)
@hammingGraph_degree : ∀ {d q : ℕ} (x : Fin d → Fin q), (hammingGraph d q).degree x = d * (q - 1)
completeGraph_lapMatrix : ∀ (q : ℕ), SimpleGraph.lapMatrix ℤ ⊤ = Kmat q
