def ColouredSand.NumberOfFactors.inclMat : (m t : ℕ) → Matrix { S // #S = t } { T // #T = t + 1 } ℤ :=
fun m t => Matrix.of fun S T => if ↑S ⊆ ↑T then 1 else 0
def ColouredSand.NumberOfFactors.rPart : ℕ → ℕ → ℕ → ℕ :=
fun p m s =>
  have t := if 2 * s ≤ m - 1 then s else m - 1 - s;
  ∑ i ∈ range (t + 1) with ¬p ∣ t + 1 - i, strMult m i
def ColouredSand.NumberOfFactors.rho : ℕ → ℕ → ℕ :=
fun p m => ∑ s ∈ range m, rPart p m s
def ColouredSand.NumberOfFactors.nFactors : ℕ → ℕ → ℕ → ℕ :=
fun p d q => ∑ j ∈ range (d + 1), d.choose j * (q - 2) ^ j * (2 ^ (d - j) - rho p (d - j)) - 1
def ColouredSand.Strings.strMult : ℕ → ℕ → ℕ :=
fun m k => m.choose k - if k = 0 then 0 else m.choose (k - 1)
