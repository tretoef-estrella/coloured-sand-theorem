fun d q => Submodule.torsion ℤ (cokerL d q)
@[reducible] def ColouredSand.TheoremB.cokerL : ℕ → ℕ → Type :=
fun d q => ((Fin d → Fin q) → ℤ) ⧸ (laplacian d q).range
