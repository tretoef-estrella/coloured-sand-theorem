def ColouredSand.Strings.opM.{u_1} : (m : ℕ) → (R : Type u_1) → [inst : CommRing R] → R → R → B m R →ₗ[R] B m R :=
fun m R [CommRing R] q c => q • (c • LinearMap.id + H m R) + U m R
def ColouredSand.Strings.H.{u_1} : (m : ℕ) → (R : Type u_1) → [inst : CommRing R] → B m R →ₗ[R] B m R :=
fun m R [CommRing R] => { toFun := fun f T => ↑T.card * f T, map_add' := ⋯, map_smul' := ⋯ }
def ColouredSand.Strings.U.{u_1} : (m : ℕ) → (R : Type u_1) → [inst : CommRing R] → B m R →ₗ[R] B m R :=
fun m R [CommRing R] => { toFun := fun f T => ∑ x ∈ T, f (T.erase x), map_add' := ⋯, map_smul' := ⋯ }
